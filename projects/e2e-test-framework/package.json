{
  "name": "e2e-test-framework",
  "version": "1.0.0",
  "description": "Enterprise-grade Playwright TypeScript End-to-End Test Automation Framework implementing Page Object Model, Custom Fixtures, Network Mocking, and Multi-browser matrix.",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report"
  },
  "keywords": ["playwright", "e2e-testing", "typescript", "sdet", "page-object-model", "test-automation"],
  "author": "Hariom",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}
